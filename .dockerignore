# ── Source control ────────────────────────────────────
.git
.gitignore

# ── Node ─────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
bun.lockb

# ── Vite build output ────────────────────────────────
dist
dist-ssr

# ── Tauri / Rust ──────────────────────────────────────
# server/ (the site server) is built in the image; only its build output is
# excluded. The Tauri shell is not part of the site image.
server/target/
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/bundle/
src-tauri/*.key

# ── Environment ───────────────────────────────────────
# All of them: Vite loads .env, .env.local, .env.production and
# .env.production.local, and a developer key must never reach the bundle.
.env
.env.*
!.env.example

# ── Editor / OS ──────────────────────────────────────
.vscode
.idea
.DS_Store
Thumbs.db
*.suo
*.sw?

# ── Test / CI artifacts ───────────────────────────────
coverage
*.lcov
.nyc_output

# ── Docs / non-build assets ───────────────────────────────────────────────────
*.md
!README.md
LICENSE

# ── Docker — keep in the build context ───────────────────────────────────────
!docker-compose.yaml
