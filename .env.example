# Copy this file to .env and fill in the values before running docker compose.
#
# If you last ran this stack before the uar-integration phase, remove the old
# UAR data volume first — it held embedded RocksDB state that the remote
# SurrealDB stack replaces:
#   docker compose down
#   docker volume ls --filter name=uar_data     # find the old volume's name
#   docker volume rm <that name>

# ── Ports ─────────────────────────────────────────────────────────────────────
# Port the KnowMe web client is exposed on (default: 8080).
# CHARCOAL_PORT is still read as a fallback for existing .env files.
KNOWME_PORT=8080

# Port the Universal Agent Runtime API is exposed on (default: 6565)
UAR_PORT=6565

# Port the surreal-memory-server API is exposed on (default: 3001)
MEMORY_SERVER_PORT=3001

# ── SurrealDB (shared by UAR and the memory server) ────────────────────────────
# Root password for the surrealdb container. The root user is fixed to "root".
SURREALDB_ROOT_PASSWORD=change-me

# ── UAR security ──────────────────────────────────────────────────────────────
# HS256 secret UAR uses to sign/verify JWTs. Also used by scripts/seed-site-agent.sh
# to mint the short-lived knowme-site JWT.
UAR_JWT_SECRET=change-me

# Secret accepted by UAR's protected settings/reload admin endpoints (X-UAR-Admin-Key).
UAR_SETTINGS_ADMIN_KEY=change-me

# Set to true in production/cluster to require JWT on all UAR requests.
UAR_SECURITY__JWT_REQUIRED=false

# ── Qwen Token Plan — chat model (OpenAI-compatible) ────────────────────────────
QWEN_TOKEN_PLAN_OPENAI_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_TOKEN_PLAN_API_KEY=sk-...
QWEN_TOKEN_PLAN_MODEL=qwen3.8-max

# ── DashScope — embedding model (OpenAI-compatible) ─────────────────────────────
DASHSCOPE_OPENAI_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-...
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMENSIONS=1024

# ── Site chat proxy (nginx → UAR) ────────────────────────────────────────────────
# X-API-Key the web container's nginx proxy injects for the knowme-site agent.
# Minted by scripts/seed-site-agent.sh (see uar/agents/knowme-site.json).
# Left empty locally until the site agent has been seeded.
SITE_PROXY_API_KEY=

# ── Site session binding ──────────────────────────────────────────────────────
# HMAC secret the site server uses to derive each visitor's upstream UAR
# session id (HMAC-SHA256(secret, cookie_id + thread_id)). Required at
# startup — the server refuses to start without it. Raw bytes, >= 32 bytes,
# and identical across every replica. Generate your own locally, e.g.
# `openssl rand -hex 32`; never commit a real value here.
SITE_SESSION_SECRET=

# ── Client build (frontend-owned; do not use in the web image build) ───────────
# These configure the *browser* build to talk to UAR directly instead of through
# the same-origin nginx proxy. Leave unset for the normal proxied setup; the web
# Docker image build excludes .env entirely (see .dockerignore).
# VITE_UAR_BASE_URL=
# VITE_UAR_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info

# site-spend-ceiling (local): the meter's SurrealDB user (ns=site, db=meter),
# created by the compose `meter-init` service. Set your own values.
SITE_METER_USER=
SITE_METER_PASS=
# Kill switch: create .compose/kill-switch/state containing `on` or `off`
# (git-ignored). Missing means on: chat is refused.
