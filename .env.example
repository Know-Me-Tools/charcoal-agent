# Copy this file to .env and fill in the values before running docker-compose.

# ── LLM provider ──────────────────────────────────────────────────────────────
# API key for the LLM provider (required)
LLM_API_KEY=sk-...

# LLM provider base URL (default: OpenAI)
LLM_BASE_URL=https://api.openai.com

# Model to use
LLM_MODEL=gpt-4o

# ── Ports ─────────────────────────────────────────────────────────────────────
# Port the KnowMe web client is exposed on (default: 8080).
# CHARCOAL_PORT is still read as a fallback for existing .env files.
KNOWME_PORT=8080

# Port the Universal Agent Runtime API is exposed on (default: 6565)
UAR_PORT=6565

# ── UAR persistence ───────────────────────────────────────────────────────────
# Persistence provider: surreal (default) or memory
UAR_PERSISTENCE__PROVIDER=surreal

# RocksDB path inside the container volume
UAR_PERSISTENCE__DATABASE_URL=rocksdb:///data/uar.db

# Embedding vector dimension (default: 384 for all-MiniLM-L6-v2)
UAR_PERSISTENCE__VECTOR_DIMENSION=384

# ── Security ──────────────────────────────────────────────────────────────────
# Set to true in production to require JWT on all UAR requests
UAR_SECURITY__JWT_REQUIRED=false

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info
